<Window x:Class="SimCineCapture.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SimCineCapture"
        Height="780"
        Width="780"
        MinHeight="520"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#111318">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SimCineCapture"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>
            <TextBlock Text="Cinematic recording toolkit for Microsoft Flight Simulator"
                       Margin="0,6,0,0"
                       FontSize="14"
                       Foreground="#B8C0CC"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#1A1F29"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="System Status"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="#121720"
                            CornerRadius="10">
                        <DockPanel>
                            <TextBlock Text="MSFS Connection"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="MsfsConnectionStateTextBlock"
                                       Text="Disconnected"
                                       Foreground="#E07A7A"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#121720"
                            CornerRadius="10">
                        <DockPanel>
                            <TextBlock Text="Recorder"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="RecorderStateTextBlock"
                                       Text="Idle"
                                       Foreground="#E5C07B"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#121720"
                            CornerRadius="10">
                        <DockPanel>
                            <TextBlock Text="Capture Backend"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="CaptureBackendStateTextBlock"
                                       Text="Not initialized"
                                       Foreground="#B8C0CC"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#121720"
                            CornerRadius="10">
                        <DockPanel>
                            <TextBlock Text="Capture Device"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="CaptureDeviceValueTextBlock"
                                       Text="No backend info"
                                       Foreground="#B8C0CC"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#121720"
                            CornerRadius="10">
                        <DockPanel>
                            <TextBlock Text="Aircraft"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="AircraftTitleValueTextBlock"
                                       Text="No telemetry yet"
                                       Foreground="#B8C0CC"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#121720"
                            CornerRadius="10">
                        <DockPanel>
                            <TextBlock Text="Position"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="PositionValueTextBlock"
                                       Text="Lat -- | Lon -- | Alt --"
                                       Foreground="#B8C0CC"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="#121720"
                            CornerRadius="10">
                        <DockPanel>
                            <TextBlock Text="Flight State"
                                       Foreground="White"
                                       FontSize="14"/>
                            <TextBlock x:Name="FlightStateValueTextBlock"
                                       Text="No data"
                                       Foreground="#B8C0CC"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#1A1F29"
                    CornerRadius="12"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Quick Actions"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <Button x:Name="ConnectButton"
                            Content="Connect to MSFS"
                            Margin="0,16,0,0"
                            Height="42"
                            Click="ConnectButton_Click"/>

                    <Button x:Name="StartRecordingButton"
                            Content="Start Recording"
                            Margin="0,12,0,0"
                            Height="42"
                            IsEnabled="False"
                            Click="StartRecordingButton_Click"/>

                    <Button x:Name="StopRecordingButton"
                            Content="Stop Recording"
                            Margin="0,12,0,0"
                            Height="42"
                            IsEnabled="False"
                            Click="StopRecordingButton_Click"/>
                    <Button x:Name="TakeSnapshotButton"
                            Content="Save Snapshot"
                            Margin="0,12,0,0"
                            Height="42"
                            Click="TakeSnapshotButton_Click"/>

                    <CheckBox x:Name="HideUiCheckBox"
                              Margin="0,18,0,0"
                              Content="Hide simulator UI during recording"
                              Foreground="White"
                              IsChecked="True"/>

                    <TextBlock Text="Capture Output"
                               Margin="0,18,0,6"
                               Foreground="White"
                               FontWeight="SemiBold"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CaptureOutputComboBox"
                                  Grid.Column="0"
                                  Height="32"
                                  VerticalContentAlignment="Center"/>

                        <Button x:Name="RefreshCaptureOutputsButton"
                                Grid.Column="2"
                                Content="↻"
                                Width="36"
                                Height="32"
                                Click="RefreshCaptureOutputsButton_Click"/>
                    </Grid>

                    <TextBlock Text="Output Directory"
                               Margin="0,18,0,6"
                               Foreground="White"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="OutputDirectoryTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BrowseOutputDirectoryButton"
                                Grid.Column="0"
                                Content="Browse Folder"
                                Height="36"
                                Click="BrowseOutputDirectoryButton_Click"/>

                        <Button x:Name="SaveOutputSettingsButton"
                                Grid.Column="2"
                                Content="Save Path"
                                Height="36"
                                Click="SaveOutputSettingsButton_Click"/>
                    </Grid>

                    <Button x:Name="OpenOutputDirectoryButton"
                            Content="Open Output Folder"
                            Margin="0,10,0,0"
                            Height="36"
                            Click="OpenOutputDirectoryButton_Click"/>

                    <TextBlock Text="Output path and UI toggle are locked while recording is active."
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="#B8C0CC"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="#1A1F29"
                CornerRadius="12"
                Padding="14">
            <TextBlock x:Name="StatusTextBlock"
                       Text="Ready. UI initialized successfully."
                       Foreground="#B8C0CC"/>
        </Border>
    </Grid>
</Window>